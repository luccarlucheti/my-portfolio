---
import Navbar from "../components/Navbar.astro";
import "../styles/global.css";
const { title = "Meu Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="pt-br" class="h-full dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body
    class="h-full flex flex-col bg-void text-starlight antialiased overflow-hidden"
  >
    <Navbar />

    <main id="contentArea" class="flex-1 overflow-y-auto">
      <div
        class="fixed inset-0 bg-[radial-gradient(ellipse_at_top,_var(--color-nebula)_0%,_transparent_25%)] opacity-10 pointer-events-none"
      >
      </div>

      <div class="relative w-full">
        <slot />
      </div>
    </main>
  </body>
</html>
