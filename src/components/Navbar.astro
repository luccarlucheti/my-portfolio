---
import LanguagePicker from "./LanguagePicker.astro";

const { pathname } = Astro.url;
const lang = pathname.startsWith("/pt") ? "pt" : "en";

const l = (path: string) => `/${lang}${path}`;

const t = {
  en: {
    home: "Home",
    about: "About Me",
    projects: "Projects",
    contact: "Contact",
  },
  pt: {
    home: "Início",
    about: "Sobre Mim",
    projects: "Projetos",
    contact: "Contato",
  },
};

const nav = t[lang];
---

<nav
  class="h-[60px] w-full flex items-center justify-between px-6
         bg-void/40 backdrop-blur-xl
         border-b border-nebula/30
         shadow-[0_4px_20px_rgba(139,92,246,0.15)]
         sticky top-0 z-50"
>
  <div class="flex items-center gap-8">
    <ul class="flex gap-6 text-sm font-medium text-hull">
      <li>
        <a href={l("/")} class="hover:text-starlight transition-colors">
          {nav.home}
        </a>
      </li>
      <li>
        <a href={l("/about")} class="hover:text-starlight transition-colors">
          {nav.about}
        </a>
      </li>
      <li>
        <a href={l("/projects")} class="hover:text-starlight transition-colors">
          {nav.projects}
        </a>
      </li>
      <li>
        <a href={l("/contact")} class="hover:text-starlight transition-colors">
          {nav.contact}
        </a>
      </li>
      <LanguagePicker />
    </ul>

    <div class="h-2 w-2 rounded-full bg-nebula animate-pulse"></div>
  </div>

  <div
    class="font-bold text-xl tracking-tighter text-nebula drop-shadow-[0_0_8px_rgba(139,92,246,0.5)]"
  >
    <span class="text-stellar/80">Lucca Roncador Lucheti</span>
  </div>
</nav>
